+
+// #083 KISS comparison: a Hesai cloud as a Velodyne one - time = point timestamp - message stamp (s), then the Velodyne path
+// (timestamp_unit 0 = seconds in the config).
+void Preprocess::hesai_handler(const sensor_msgs::PointCloud2::ConstPtr &msg)
+{
+    pcl::PointCloud<hesai_ros::Point> pl_hesai;
+    pcl::fromROSMsg(*msg, pl_hesai);
+    const double t0 = msg->header.stamp.toSec();
+    pcl::PointCloud<velodyne_ros::Point> pl_orig;
+    pl_orig.points.resize(pl_hesai.points.size());
+    for (size_t i = 0; i < pl_hesai.points.size(); ++i) {
+        const auto &p = pl_hesai.points[i];
+        auto &q = pl_orig.points[i];
+        q.x = p.x; q.y = p.y; q.z = p.z; q.intensity = p.intensity; q.ring = p.ring;
+        q.time = float(p.timestamp - t0);
+    }
+    velodyne_process(pl_orig);
+}
+
+void Preprocess::velodyne_process(pcl::PointCloud<velodyne_ros::Point> &pl_orig)
+{
     pl_surf.clear();
