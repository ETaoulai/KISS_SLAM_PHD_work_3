diff --git a/run_trajlo_headless.cpp b/run_trajlo_headless.cpp
new file mode 100644
index 0000000..13b525a
--- /dev/null
+++ b/run_trajlo_headless.cpp
@@ -0,0 +1,26 @@
+// KISS comparison (#083): Traj-LO without the GUI - the same odometry, fed straight from the data loader.
+#include <trajlo/core/odometry.h>
+#include <trajlo/io/data_loader.h>
+#include <trajlo/utils/config.h>
+
+#include <iostream>
+#include <thread>
+
+int main(int argc, char *argv[]) {
+  if (argc < 2) {
+    std::cerr << "Usage: " << argv[0] << " <config_path>" << std::endl;
+    return 1;
+  }
+  traj::TrajConfig config;
+  config.load(argv[1]);
+  {
+    traj::TrajLOdometry::Ptr odometry(new traj::TrajLOdometry(config));
+    traj::DataLoader::Ptr loader = traj::DatasetFactory::GetDatasetIo(config.type);
+    odometry->Start();
+    loader->laser_queue = &odometry->laser_data_queue;
+    loader->start();
+    std::thread t_io(&traj::DataLoader::publish, loader, config.dataset_path, config.topic);
+    t_io.join();
+  }  // ~TrajLOdometry joins the processing thread, which writes the poses at the end of the data
+  return 0;
+}
